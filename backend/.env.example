# App
APP_NAME="Student Engagement Analysis"
APP_VERSION="2.0.0"
DEBUG=False
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────────────────────────
# Option 1: Neon.tech PostgreSQL (free tier) — RECOMMENDED
# Get your connection string from https://console.neon.tech → project → Connection details
# Example format: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://your_neon_user:your_neon_password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 2: Local SQLite (for offline development only)
# DATABASE_URL=sqlite+aiosqlite:///./engagement_db.db

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Cloudinary (optional, for report image uploads) ───────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret